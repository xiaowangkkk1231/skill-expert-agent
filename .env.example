# Skill Expert Agent 配置示例
# 复制为 .env 后修改

# 运行模式: auto | rule | llm
#   auto = 配了 LLM_API_KEY 就走模型，否则用内置规则引擎
#   rule = 强制用内置规则引擎（离线、免费、可测试）
#   llm  = 强制走模型（没有 key 会报错）
SEA_PROVIDER=auto

# 任何 OpenAI 兼容端点都可以：OpenRouter / DeepSeek / 智谱 / 本地 vLLM
SEA_LLM_BASE_URL=https://openrouter.ai/api/v1
SEA_LLM_API_KEY=
SEA_LLM_MODEL=anthropic/claude-3.5-haiku

# 输入上限（字符）
SEA_MAX_INPUT_CHARS=60000

# 演示节奏：每段流式输出之间插入的毫秒延迟。0 = 不打磨，真实速度
SEA_STREAM_PACE_MS=0

# 数据库
SEA_DB_URL=sqlite:///./data/sea.db
